{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3:8b-agent",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow"
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3:8b-agent": {
          "name": "Qwen3 8B Agent (local)",
          "limit": {
            "context": 8192,
            "output": 8192
          }
        }
      }
    }
  }
}
